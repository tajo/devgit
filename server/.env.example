# Numeric GitHub App ID (from the App's settings page header).
GITHUB_APP_ID=3694599

# Absolute path to the App's RSA private key (.pem file).
GITHUB_APP_PRIVATE_KEY_PATH=/Users/vojtech/Downloads/devgit-go.2026-05-14.private-key.pem

# Optional: which interface/port to bind. Defaults to 127.0.0.1:3000.
# Bind to 127.0.0.1 only — this server holds the App's private key and
# should never be reachable from the network.
PORT=3000
HOST=127.0.0.1
